#!/bin/sh

# #SBATCH -e err
# #SBATCH -o out
# #SBATCH --account=@[ACCNR]
# #SBATCH --qos=@[QUEUE]
# #SBATCH --partition=@[PARTITION]
# ### #SBATCH --ntasks=@[TASKS]
# #SBATCH --nodes=@[NODES]
# #SBATCH --ntasks-per-node=@[TPN]
# #SBATCH --time=@[WLCLK]
# #SBATCH --job-name="@[JBNME]"
# #SBATCH --exclusive

set -eux
echo -n " $( date +%s )," >  job_timestamp.txt

MACHINE_ID=ioossb
source ./module-setup.sh
module use $PWD/modulefiles

# This is how it was done in compile step
#modulefile="ufs_${MACHINE_ID}.${RT_COMPILER}"
#module load "${modulefile}"
#module list

# In this run_test chain, the module file should have been copied to a generic name
# This is not the same as what was done in compile step - but essentially same result
module load modules.fv3
module list

echo "PT DEBUG in: fv3_conf/fv3_cloudflow.IN_ioossb (job.card)"
set -x

# Set fi fabric to AWS if using it
export I_MPI_OFI_LIBRARY_INTERNAL=0   # 0: use aws efa fabric 1: use intel efa fabric

#export I_MPI_OFI_LIBRARY_INTERNAL=1   # 0: use aws efa fabric 1: use intel efa fabric
#export I_MPI_FABRICS=shm:ofi

# Turn this off if the node type does not support efa
# export I_MPI_OFI_PROVIDER=efa
# export FI_PROVIDER=efa

# Might default to sockets - sockets is really slow
# Might be needed for AWS fabric
export LD_LIBRARY_PATH="/opt/amazon/efa/lib64:$LD_LIBRARY_PATH"
export FI_PROVIDER_PATH=/opt/amazon/efa/lib64/libfabric

# Testing
export I_MPI_FABRICS=shm
export I_MPI_DEBUG=5

unset I_MPI_OFI_PROVIDER
unset FI_PROVIDER

# export FI_PROVIDER=shm
# export I_MPI_DEBUG=1
# Not supported with aws fabric export I_MPI_OFI_PROVIDER_DUMP=1

ulimit -s unlimited

# PT TODO: Check these
#export MPI_TYPE_DEPTH=20
#export OMP_STACKSIZE=512M
#export KMP_AFFINITY=scatter
#export OMP_NUM_THREADS=@[THRD]
#export ESMF_RUNTIME_COMPLIANCECHECK=OFF:depth=4
#export PSM_RANKS_PER_CONTEXT=4
#export PSM_SHAREDCONTEXTS=1

export ESMF_RUNTIME_PROFILE=ON
export ESMF_RUNTIME_PROFILE_OUTPUT="SUMMARY"

# For Parallel filesystems
# export I_MPI_FILESYSTEM=ON
# export FI_MLX_INJECT_LIMIT=0

echo "Model started:  " `date`

# Avoid job errors because of filesystem synchronization delays
sync && sleep 1

# This "if" block is part of the rt.sh self-tests in error-test.conf. It emulates the model failing to run.
if [ "${JOB_SHOULD_FAIL:-NO}" = WHEN_RUNNING ] ; then
    echo "The job should abort now, with exit status 1." 1>&2
    echo "If error checking is working, the metascheduler should mark the job as failed." 1>&2
    false
fi

HOSTS=@[HOSTS]
NPROCS=@[NPROCS]
PPN=@[PPN]

#PT logic to turn on efa, hacky way for now
#Multiple hosts, should be using EFA
#if [ $NPROCS > $PPN ]; then
#  export I_MPI_OFI_PROVIDER=efa
#  export FI_PROVIDER=efa
#fi

jobname="@[JBNME]"

MPIOPTS="-launcher ssh -hosts $HOSTS -np $NPROCS -ppn $PPN"

# mpirun $MPIOPTS ./fv3.exe >& ${jobname}.out

# Need to redirect stdin from /dev/null to not interfere with rt.sh read line < TESTS_FILE stdin
# generate_log expects some output to be in "out"
mpirun $MPIOPTS ./fv3.exe < /dev/null >& out

# Can use tee to output to two file
# mpirun $MPIOPTS ./fv3.exe < /dev/null | tee 
# your_command > >(tee file1.log > file2.log) 2>&1

rc=$?
if [[ $rc -eq 0 ]]; then
    echo 'Model run completed successfully'
else
    echo "Model run failed with rc=$rc"
fi

echo "Model ended:    " `date`
echo -n " $( date +%s )," >> job_timestamp.txt
