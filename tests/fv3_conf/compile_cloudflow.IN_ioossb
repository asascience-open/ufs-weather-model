#!/bin/sh
set -eux

# atparse will replace this with the hostnames of the current local cluster 
HOSTS=@[HOSTS]

# if hosts is empty, we are running locally
FIRST_HOST=${HOSTS%%,*}
FIRST_HOST=${FIRST_HOST// /}

echo -n " $( date +%s )," >  job_timestamp.txt
echo "Compile started:  " `date`

# For cloudflow, need to ssh into machine and run compile on first node in hosts
# use ssh -n to redirect stdin from /dev/null, otherwise breaks rt.sh read < TEST_CONF
ssh -n -o BatchMode=yes $FIRST_HOST @[PATHRT]/compile.sh @[MACHINE_ID] \"@[MAKE_OPT]\" @[COMPILE_ID] @[RT_COMPILER] YES NO >& "${LOG_DIR}/compile.log"
rc=$?

if [[ $rc -eq 0 ]]; then
    echo 'Compile completed successfully'
else
    echo "Compile failed with rc=$rc"
fi
echo "Compile ended:    " `date`
echo -n " $( date +%s )," >> job_timestamp.txt

# Propagate exit status ?
